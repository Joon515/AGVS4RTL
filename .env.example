# Optional LLM runtime configuration for local development.
# Copy to .env and fill real values. Never commit .env.

AGVS4RTL_LLM_ENABLED=false
AGVS4RTL_LLM_BASE_URL=
AGVS4RTL_LLM_API_KEY=
AGVS4RTL_LLM_MODEL=
AGVS4RTL_LLM_PROFILE=default

# User mapping — run 'id -u && id -g' on host to get your values
USER_ID=1000
GROUP_ID=1000

# Timeout settings (seconds)
VERIFY_SERVICE_TIMEOUT_SECONDS=240
GEN_SERVICE_TIMEOUT_SECONDS=600
AGVS4RTL_LLM_TIMEOUT_SECONDS=300
