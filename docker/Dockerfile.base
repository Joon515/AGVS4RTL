# 使用轻量的 Python 运行时
FROM python:3.11-slim-bullseye

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local/ \
    PYTHONPATH=/app

# 安装基础系统工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv (高性能包管理工具)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 设置工作目录
WORKDIR /app

# 预创建共享空间目录并直接开放权限，解决非 root 挂载报错
RUN mkdir -p /app/shared_workspace /app/src && chmod -R 777 /app

# 复制依赖描述文件
COPY pyproject.toml . 

# 【核心改动】安装微服务全家桶：FastAPI 替代 Celery，httpx 替代 Redis 总线
RUN uv pip install --system \
    fastapi uvicorn httpx pydantic langgraph semantic-router

# 同步 pyproject.toml 里的其它业务依赖
RUN uv pip install --system . || true

# 核心权限修复：彻底放开 Python 库和二进制文件的读取/执行权限
RUN chmod -R a+rX /usr/local/lib/python3.11/site-packages
RUN chmod -R a+rx /usr/local/bin/

WORKDIR /app