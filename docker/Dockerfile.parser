# docker/Dockerfile.parser
FROM agvs4rtl-base:latest

# 1. 安装 Parser 专用的智能路由与状态机依赖 (去掉了 celery)
RUN uv pip install --system semantic-router langgraph

# 2. 拷贝 Parser 相关的业务逻辑
COPY ./src /app/src

# 3. 设置工作目录与环境变量
WORKDIR /app
ENV PYTHONPATH=/app

# 4. 启动 FastAPI 服务 (Parser 中枢 API)
CMD ["uvicorn", "src.parser.main:app", "--host", "0.0.0.0", "--port", "8000"]