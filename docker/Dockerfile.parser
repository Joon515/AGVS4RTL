# docker/Dockerfile.parser
FROM python:3.11-slim-bullseye

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	UV_PROJECT_ENVIRONMENT=/usr/local/ \
	PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
	git \
	build-essential \
	curl \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

RUN mkdir -p /app/shared_workspace /app/src && chmod -R 777 /app

COPY pyproject.toml .
RUN uv pip install --system \
	fastapi uvicorn httpx pydantic langgraph semantic-router
RUN uv pip install --system . || true

RUN chmod -R a+rX /usr/local/lib/python3.11/site-packages
RUN chmod -R a+rx /usr/local/bin/

COPY ./src /app/src

WORKDIR /app
ENV PYTHONPATH=/app

CMD ["uvicorn", "src.parser.main:app", "--host", "0.0.0.0", "--port", "8000"]