FROM python:3.11-slim-bullseye
>>>>>>> parent of 954c15d (初步解决了环境问题，通过删除venv、重置bash解决。为输出添加了openai的build_json_schema_response_format以约束输出内容，防止输出内容不符合类型要求。原测试已通过，但新增的更复杂、模糊的测试出现严重的假通过问题，待明天解决)

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
	git \
	build-essential \
	curl \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /app/shared_workspace /app/src && chmod -R 777 /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN chmod -R a+rX /usr/local/lib/python3.11/site-packages
RUN chmod -R a+rx /usr/local/bin/

COPY ./src /app/src

WORKDIR /app
ENV PYTHONPATH=/app

CMD ["uvicorn", "src.parser.main:app", "--host", "0.0.0.0", "--port", "8000"]