# docker/Dockerfile.verify
FROM agvs4rtl-base:latest

# 1. 安装 EDA 工具链 (Icarus Verilog 和 Make)
RUN apt-get update && apt-get install -y --no-install-recommends \
    iverilog \
    make \
    && rm -rf /var/lib/apt/lists/*

# 2. 安装 Cocotb 验证框架与 AST 解析库
RUN uv pip install --system cocotb cocotb-test pytest pyverilog

# 3. 拷贝验证逻辑
COPY ./src /app/src

# 4. 设置环境变量
WORKDIR /app
ENV PYTHONPATH=/app

# 5. 启动 FastAPI 服务 (Verify 接口)
# 用 --workers 2 限制并发验证任务数
CMD ["uvicorn", "src.verify.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]