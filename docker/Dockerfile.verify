FROM python:3.11-slim-bullseye
>>>>>>> parent of 954c15d (初步解决了环境问题，通过删除venv、重置bash解决。为输出添加了openai的build_json_schema_response_format以约束输出内容，防止输出内容不符合类型要求。原测试已通过，但新增的更复杂、模糊的测试出现严重的假通过问题，待明天解决)

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# 1. 安装基础工具与 EDA 工具链
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    curl \
    iverilog \
    make \
    && rm -rf /var/lib/apt/lists/*

# 2. 设置工作目录与共享空间
WORKDIR /app
RUN mkdir -p /app/shared_workspace /app/src && chmod -R 777 /app

# 3. 安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. 放宽运行所需执行权限
RUN chmod -R a+rX /usr/local/lib/python3.11/site-packages
RUN chmod -R a+rx /usr/local/bin/

# 5. 拷贝验证逻辑
COPY ./src /app/src

# 6. 启动 FastAPI 服务 (Verify 接口)
# 用 --workers 2 限制并发验证任务数
WORKDIR /app
ENV PYTHONPATH=/app
CMD ["uvicorn", "src.verify.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]