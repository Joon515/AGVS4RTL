# 6. 放宽运行所需执行权限
RUN chmod -R a+rX /usr/local/lib/python3.11/site-packages
RUN chmod -R a+rx /usr/local/bin/

# 7. 拷贝生成逻辑
COPY ./src /app/src

# 8. 启动 FastAPI 服务 (Gen 接口)
WORKDIR /app
ENV PYTHONPATH=/app
CMD ["uvicorn", "src.generator.main:app", "--host", "0.0.0.0", "--port", "8000"]